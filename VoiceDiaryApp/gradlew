#!/bin/sh

# Gradle startup script for POSIX generated by Gradle.

APP_NAME="Gradle"
APP_BASE_NAME=$(basename "$0")

# Use the maximum available, or set MAX_FD != -1 to use that value.
MAX_FD=maximum

die() {
    echo "$*"
    exit 1
}

# Determine the Java command to use to start the JVM.
if [ -n "$JAVA_HOME" ] ; then
    JAVACMD="$JAVA_HOME/bin/java"
elif [ -x "/usr/lib/jvm/java-17-openjdk/bin/java" ] ; then
    JAVACMD="/usr/lib/jvm/java-17-openjdk/bin/java"
elif type java >/dev/null 2>&1 ; then
    JAVACMD=java
else
    die "JAVA_HOME is not set and no 'java' command could be found in your PATH."
fi

# Setup the Gradle environment
DIRNAME=$(dirname "$0")
APP_HOME=$(cd "$DIRNAME" && pwd -P)

# Add default JVM options here.
DEFAULT_JVM_OPTS='"-Xmx64m" "-Xms64m"'

CLASSPATH=$APP_HOME/gradle/wrapper/gradle-wrapper.jar

# Determine the JVM's command line arguments.
eval set -- $DEFAULT_JVM_OPTS $JAVA_OPTS \
    -classpath "$CLASSPATH" \
    org.gradle.wrapper.GradleWrapperMain \
    "$@"

exec "$JAVACMD" "$@"
